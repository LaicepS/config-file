[user]
    email = dorian.haglund@trust-in-soft.com
    name = Dorian Haglund
[core]
    pager = less -F -X
[push]
    default = current
[difftool]
    prompt = false
    tool = gvimdiff

[merge]
  tool = gvimdiff

[diff]
    tool = gvimdiff
  relativePaths = true

[alias]
    dt = difftool
    co = checkout
    st = status
    adog = log --all --decorate --oneline --graph
    follow = log -p -M --follow --stat --
    merges = log --oneline --decorate --color=auto --merges --first-parent

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = store
[status]
	relativePaths = true
[safe]
	directory = /builds/trust/googletest
